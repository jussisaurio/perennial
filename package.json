{
  "name": "perennial",
  "private": true,
  "workspaces": ["contract", "web", "server", "scripts"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:ai": "bun scripts/dev.ts --ai",
    "check": "bun scripts/check.ts",
    "real-use": "bun web/src/realUse/cli.ts",
    "real-use:sim": "TZ=UTC bun web/src/realUse/sim.ts",
    "knip": "knip && knip --production",
    "deadcode": "bun scripts/deadcode.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint"
  },
  "devDependencies": {
    "knip": "^6.45.0",
    "railway": "^3.16.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.4",
    "dompurify": "^3.4.17"
  }
}
