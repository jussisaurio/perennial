{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // A pattern ending in "!" is production code: `knip --production` checks only those.
  // An export that only tests or scripts/ use gets a JSDoc `@internal <reason>` tag, which production mode skips.
  // Never let a plain pattern cover a "!" one: production mode then checks nothing at all (#832).
  "workspaces": {
    ".": {
      // Playwright loads it when someone runs it at the root by mistake: it fails with the fix.
      "entry": ["playwright.config.ts"]
    },
    "scripts": {
      // Command-line tools run by hand (README.md, docs/decks.md, docs/DEPLOY.md). None of it ships.
      "entry": ["deck/*.ts", "tts/render.ts", "tts/fix.ts", "*.ts"],
      "project": ["**/*.ts"]
    },
    "server": {
      // Railway runs migrate before each deploy and housekeeping as a daily cron (docs/DEPLOY.md).
      // auth.cli.ts is config for the Better Auth CLI: `bunx auth generate --config auth.cli.ts`.
      "entry": ["instrument.ts!", "src/{migrate,housekeeping}.ts!", "auth.cli.ts"],
      // Tests, the load test and the mock LLM are not production code.
      "project": ["src/**/*.ts!", "mock-llm.ts", "test/**/*.ts", "load/**/*.ts"],
      // web/src/core/fsrs.ts imports it when the demo runs the app's planner (Dockerfile).
      "ignoreDependencies": ["ts-fsrs"]
    },
    "web": {
      // Playwright picks these files by a testMatch regex, which knip does not read.
      // e2e/coverage-report.ts is run by scripts/deadcode.ts. e2e/compare.ts is `bun run compare`; e2e/pairwise.ts is run by hand (docs/judges.md). src/realUse is run by the root's `bun run real-use` and `real-use:sim`.
      "entry": ["e2e/warm.setup.ts", "e2e/shots.ts", "e2e/look.run.ts", "e2e/live.run.ts", "e2e/coverage-report.ts", "e2e/compare.ts", "e2e/pairwise.ts", "src/realUse/{cli,sim}.ts"],
      // e2e/, perf/, the learner simulation (src/sim, run by `bun run sim:learners`), the real-use report (src/realUse) and the garden fuzzer (src/fuzz, `bun run fuzz:garden`) are tools, not production code.
      "project": ["src/**/*.{ts,tsx}!", "!src/sim/**!", "!src/realUse/**!", "!src/fuzz/**!", "e2e/**/*.ts", "perf/**/*.ts"],
      // Imported from index.css, and knip does not read CSS @import.
      "ignoreDependencies": ["@fontsource/gloock", "@fontsource-variable/onest"],
      // e2e specs import app modules by their Vite dev-server URL inside the page.
      "ignoreUnresolved": ["^/src/"]
    }
  }
}
