{
  "name": "perennial-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --preload ./instrument.ts index.ts",
    "dev": "LOG_PRETTY=1 bun --watch --preload ./instrument.ts index.ts",
    "migrate": "bun src/migrate.ts",
    "housekeeping": "bun --preload ./instrument.ts src/housekeeping.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "load": "bun load/run.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@sentry/bun": "11",
    "better-auth": "1.7.20",
    "effect": "4.0.0",
    "perennial-contract": "workspace:*",
    "pg": "8",
    "resend": "^6.38.0",
    "ts-fsrs": "^6.0.0"
  }
}
