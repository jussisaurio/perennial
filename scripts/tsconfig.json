{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true
  },
  "include": ["deck", "*.ts"]
}
